{
  "redirects": [
    {
      "source": "/servicios/:query*",
      "destination": "/buscar/:query*",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/buscar",
      "permanent": true
    },
    {
      "source": "/crear-solicitud",
      "destination": "/nueva-solicitud",
      "permanent": true
    },
    {
      "source": "/analytics",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images|icons|fonts|assets|favicon|servicios|crear-solicitud|analytics).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}